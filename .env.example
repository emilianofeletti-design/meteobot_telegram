# ============================================================
# .env.example - meteobot_telegram
# Copia questo file in ".env" (che NON va mai committato)
# e incolla i tuoi valori reali. Vedi SETUP.md.
# ============================================================

# Token del bot Telegram ottenuto da @BotFather
TELEGRAM_TOKEN=

# Il tuo chat_id numerico ottenuto da @userinfobot
CHAT_ID=

# Personal Access Token GitHub (scope: repo + workflow)
PAT_TOKEN=

# API key Groq (opzionale: se vuota il riassunto LLM e' disattivato)
GROQ_API_KEY=

# Configurazione del backend
GITHUB_REPOSITORY=emilianofeletti-design/meteobot_telegram
DB_BRANCH=db
DB_DIR=db